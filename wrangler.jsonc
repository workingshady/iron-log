{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iron-log",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iron-log",
      "database_id": "c308d766-195f-4a1e-a355-81561dc01e23",
      "migrations_dir": "migrations"
    },
    {
      // DEV / test mode: same app, separate database with dummy data (log in with the DEV passcode).
      "binding": "DB_DEV",
      "database_name": "iron-log-dev",
      "database_id": "d47039c1-f4af-442c-8bb0-e8061da90bb0",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI (free: 10k neurons/day ≈ 200 min of Whisper) — voice notes → text, Arabic + English + mixed.
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Chat: one Durable Object per conversation (SQLite-backed → available on the free plan), WebSocket hibernation.
  "durable_objects": { "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }]
}
